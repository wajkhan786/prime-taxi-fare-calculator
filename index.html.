<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Prime Taxis Fare Calculator</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #f4f5f7;
    margin: 0;
    padding: 20px;
    color: #222;
}

.box {
    max-width: 520px;
    margin: auto;
    background: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 3px 15px rgba(0,0,0,.12);
}

h1 {
    margin-top: 0;
    text-align: center;
}

.subtitle {
    text-align: center;
    color: #666;
    margin-bottom: 25px;
}

label {
    display: block;
    font-weight: bold;
    margin-top: 15px;
    margin-bottom: 6px;
}

input,
select,
button {
    width: 100%;
    box-sizing: border-box;
    padding: 14px;
    border: 1px solid #ccc;
    border-radius: 10px;
    font-size: 16px;
}

button {
    background: #111;
    color: white;
    font-weight: bold;
    cursor: pointer;
    margin-top: 20px;
}

button:hover {
    background: #333;
}

.result {
    background: #eef7ee;
    padding: 20px;
    margin-top: 20px;
    border-radius: 12px;
}

.price {
    font-size: 38px;
    font-weight: bold;
    text-align: center;
    margin: 10px 0 20px;
}

.details {
    line-height: 1.7;
}

.error {
    color: #a00;
    background: #fff0f0;
    padding: 12px;
    border-radius: 8px;
    margin-top: 15px;
}

.small {
    color: #666;
    font-size: 13px;
    margin-top: 5px;
}

.row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

hr {
    border: 0;
    border-top: 1px solid #ddd;
    margin: 18px 0;
}

.loading {
    text-align: center;
    padding: 15px;
    color: #555;
}

.notice {
    background: #fff8e6;
    padding: 12px;
    border-radius: 8px;
    margin-top: 15px;
    font-size: 13px;
    line-height: 1.5;
}

@media(max-width:500px) {
    .row {
        grid-template-columns: 1fr;
    }

    body {
        padding: 10px;
    }

    .box {
        padding: 18px;
    }
}
</style>
</head>

<body>

<div class="box">

<h1>Prime Taxis</h1>

<p class="subtitle">
Waverley By-the-Book Fare Calculator
</p>

<label for="from">From</label>

<input
    id="from"
    placeholder="Postcode, road or location name"
>

<div class="small">
Example: GU7 1AA, Godalming Station, High Street
</div>


<label for="to">To</label>

<input
    id="to"
    placeholder="Postcode, road or location name"
>

<div class="small">
You can use a postcode, road name or location name.
</div>


<div class="row">

<div>

<label for="passengers">
Passengers
</label>

<input
    id="passengers"
    type="number"
    min="1"
    value="1"
>

</div>


<div>

<label for="waiting">
Traffic / waiting delay
</label>

<input
    id="waiting"
    type="number"
    min="0"
    step="1"
    value="0"
>

<div class="small">
Additional delay in minutes.
</div>

</div>

</div>


<label for="dateTime">
Journey date and time
</label>

<input
    id="dateTime"
    type="datetime-local"
>


<label for="tariff">
Tariff
</label>

<select id="tariff">

<option value="auto">
Automatic
</option>

<option value="1">
Tariff 1 - Day
</option>

<option value="2">
Tariff 2 - Evening / Bank Holiday
</option>

<option value="3">
Tariff 3 - Christmas / New Year
</option>

</select>


<button onclick="calculateFare()">
CALCULATE FARE
</button>


<div id="loading"
     class="loading"
     style="display:none;">
Finding locations and calculating route...
</div>


<div id="error"></div>


<div id="result"
     class="result"
     style="display:none;">

<div id="fare"
     class="price">
£0.00
</div>

<div id="details"
     class="details">
</div>

</div>

</div>


<script>

/* =====================================================
   WAVERLEY FARE CHART
   ===================================================== */

const FARES = {

    tariff1: {
        firstMileWeekday: 4.96,
        firstMileSunday: 5.56,
        additionalMile: 2.76,
        timeFirst: 2.40,
        timeAdditional: 0.20
    },

    tariff2: {
        firstMile: 7.43,
        additionalMile: 4.13,
        timeFirst: 3.60,
        timeAdditional: 0.30
    },

    tariff3: {
        firstMile: 9.91,
        additionalMile: 5.52,
        timeFirst: 4.80,
        timeAdditional: 0.40
    },

    bookingFee: 0.60,

    extraPassenger: 0.30,

    yardsPerUnit: 128,

    secondsPerUnit: 22
};


/* =====================================================
   SET CURRENT DATE/TIME
   ===================================================== */

window.addEventListener("load", function() {

    const now = new Date();

    const local =
        new Date(
            now.getTime()
            - now.getTimezoneOffset() * 60000
        )
        .toISOString()
        .slice(0,16);

    document.getElementById("dateTime").value = local;

});


/* =====================================================
   AUTOMATIC TARIFF
   ===================================================== */

function getAutomaticTariff(date) {

    const month = date.getMonth();
    const day = date.getDate();

    const weekday = date.getDay();

    const hour = date.getHours();


    /* Christmas / New Year */

    if (
        (month === 11 && day === 24 && hour >= 23) ||
        (month === 11 && day === 25) ||
        (month === 11 && day === 26) ||
        (month === 11 && day === 27 && hour < 7) ||
        (month === 11 && day === 31 && hour >= 23) ||
        (month === 0 && day === 1) ||
        (month === 0 && day === 2 && hour < 7)
    ) {
        return 3;
    }


    /* 11pm - 7am */

    if (hour >= 23 || hour < 7) {
        return 2;
    }


    /* Sunday daytime */

    if (weekday === 0) {
        return 1;
    }


    /* Monday - Saturday daytime */

    return 1;
}


/* =====================================================
   GEOCODE POSTCODE / ROAD / LOCATION
   ===================================================== */

async function geocode(place) {

    const url =
        "https://nominatim.openstreetmap.org/search" +
        "?format=json" +
        "&limit=1" +
        "&countrycodes=gb" +
        "&q=" +
        encodeURIComponent(place);


    const response =
        await fetch(url, {
            headers: {
                "Accept": "application/json"
            }
        });


    if (!response.ok) {
        throw new Error(
            "Unable to find " + place
        );
    }


    const data =
        await response.json();


    if (!data.length) {

        throw new Error(
            "Location not found: " +
            place +
            ". Try a postcode, road name or location name."
        );

    }


    return {

        lat: parseFloat(data[0].lat),

        lon: parseFloat(data[0].lon),

        name: data[0].display_name

    };
}


/* =====================================================
   GET DRIVING ROUTE
   ===================================================== */

async function getRoute(from, to) {

    const url =
        "https://router.project-osrm.org/route/v1/driving/" +

        from.lon +
        "," +
        from.lat +

        ";" +

        to.lon +
        "," +
        to.lat +

        "?overview=false";


    const response =
        await fetch(url);


    if (!response.ok) {

        throw new Error(
            "Unable to calculate driving route."
        );

    }


    const data =
        await response.json();


    if (
        !data.routes ||
        !data.routes.length
    ) {

        throw new Error(
            "No driving route could be found."
        );

    }


    return {

        distanceMiles:
            data.routes[0].distance /
            1609.344,

        durationMinutes:
            data.routes[0].duration /
            60

    };
}


/* =====================================================
   DISTANCE FARE
   ===================================================== */

function calculateDistanceFare(
    miles,
    tariff,
    sunday
) {

    let firstMile;
    let additionalMile;


    if (tariff === 1) {

        firstMile =
            sunday
            ? FARES.tariff1.firstMileSunday
            : FARES.tariff1.firstMileWeekday;

        additionalMile =
            FARES.tariff1.additionalMile;

    }


    else if (tariff === 2) {

        firstMile =
            FARES.tariff2.firstMile;

        additionalMile =
            FARES.tariff2.additionalMile;

    }


    else {

        firstMile =
            FARES.tariff3.firstMile;

        additionalMile =
            FARES.tariff3.additionalMile;

    }


    if (miles <= 1) {
        return firstMile;
    }


    const extraMiles =
        Math.ceil(miles - 1);


    return (
        firstMile +
        extraMiles * additionalMile
    );
}


/* =====================================================
   EXTRA WAITING / TRAFFIC TIME
   ===================================================== */

function calculateWaitingFare(
    minutes,
    tariff
) {

    if (minutes <= 0) {
        return 0;
    }


    const seconds =
        minutes * 60;


    const units =
        Math.ceil(
            seconds /
            FARES.secondsPerUnit
        );


    let firstCharge;
    let additionalCharge;


    if (tariff === 1) {

        firstCharge =
            FARES.tariff1.timeFirst;

        additionalCharge =
            FARES.tariff1.timeAdditional;

    }


    else if (tariff === 2) {

        firstCharge =
            FARES.tariff2.timeFirst;

        additionalCharge =
            FARES.tariff2.timeAdditional;

    }


    else {

        firstCharge =
            FARES.tariff3.timeFirst;

        additionalCharge =
            FARES.tariff3.timeAdditional;

    }


    if (units <= 1) {
        return firstCharge;
    }


    return (
        firstCharge +
        (units - 1) *
        additionalCharge
    );
}


/* =====================================================
   MAIN CALCULATOR
   ===================================================== */

async function calculateFare() {

    const fromText =
        document.getElementById("from")
        .value
        .trim();


    const toText =
        document.getElementById("to")
        .value
        .trim();


    const passengers =
        parseInt(
            document.getElementById("passengers")
            .value
        ) || 1;


    const waitingMinutes =
        parseFloat(
            document.getElementById("waiting")
            .value
        ) || 0;


    const dateTimeValue =
        document.getElementById("dateTime")
        .value;


    const tariffChoice =
        document.getElementById("tariff")
        .value;


    const error =
        document.getElementById("error");


    const result =
        document.getElementById("result");


    const loading =
        document.getElementById("loading");


    error.innerHTML = "";

    result.style.display = "none";


    if (!fromText || !toText) {

        error.innerHTML =
            '<div class="error">' +
            'Please enter both pickup and destination.' +
            '</div>';

        return;
    }


    if (passengers < 1) {

        error.innerHTML =
            '<div class="error">' +
            'Passengers must be at least 1.' +
            '</div>';

        return;
    }


    if (waitingMinutes < 0) {

        error.innerHTML =
            '<div class="error">' +
            'Waiting time cannot be negative.' +
            '</div>';

        return;
    }


    loading.style.display = "block";


    try {

        /* FIND PICKUP */

        const from =
            await geocode(fromText);


        /* FIND DESTINATION */

        const to =
            await geocode(toText);


        /* FIND DRIVING ROUTE */

        const route =
            await getRoute(
                from,
                to
            );


        const miles =
            route.distanceMiles;


        /* DATE */

        const journeyDate =
            dateTimeValue
            ? new Date(dateTimeValue)
            : new Date();


        const sunday =
            journeyDate.getDay() === 0;


        /* TARIFF */

        let tariff;


        if (tariffChoice === "auto") {

            tariff =
                getAutomaticTariff(
                    journeyDate
                );

        }

        else {

            tariff =
                parseInt(
                    tariffChoice
                );

        }


        /* DISTANCE FARE */

        const distanceFare =
            calculateDistanceFare(
                miles,
                tariff,
                sunday
            );


        /*
           IMPORTANT:

           Waiting/traffic entered here is
           ADDITIONAL delay time.

           It is NOT the normal route duration.
        */

        const waitingFare =
            calculateWaitingFare(
                waitingMinutes,
                tariff
            );


        /* EXTRA PASSENGERS */

        const extraPassengers =
            Math.max(
                0,
                passengers - 1
            );


        const passengerFare =
            extraPassengers *
            FARES.extraPassenger;


        /* BOOKING */

        const bookingFee =
            FARES.bookingFee;


        /* TOTAL */

        const total =
            distanceFare +
            waitingFare +
            passengerFare +
            bookingFee;


        /* TARIFF NAME */

        let tariffName;


        if (tariff === 1) {

            tariffName =
                sunday
                ? "Tariff 1 - Sunday"
                : "Tariff 1 - Day";

        }

        else if (tariff === 2) {

            tariffName =
                "Tariff 2 - Evening / Bank Holiday";

        }

        else {

            tariffName =
                "Tariff 3 - Christmas / New Year";

        }


        /* DISPLAY TOTAL */

        document.getElementById("fare")
            .innerText =
            "£" +
            total.toFixed(2);


        /* DISPLAY BREAKDOWN */

        document.getElementById("details")
            .innerHTML =

            "<b>" +
            tariffName +
            "</b><br><br>" +

            "<b>From:</b> " +
            escapeHtml(fromText) +
            "<br>" +

            "<b>To:</b> " +
            escapeHtml(toText) +
            "<br><br>" +

            "<b>Driving distance:</b> " +
            miles.toFixed(2) +
            " miles<br>" +

            "<b>Estimated driving time:</b> " +
            Math.round(
                route.durationMinutes
            ) +
            " minutes<br><br>" +

            "<b>Distance fare:</b> £" +
            distanceFare.toFixed(2) +
            "<br>" +

            "<b>Additional traffic / waiting:</b> £" +
            waitingFare.toFixed(2) +
            "<br>" +

            "<b>Booking fee:</b> £" +
            bookingFee.toFixed(2) +
            "<br>" +

            "<b>Extra passengers:</b> £" +
            passengerFare.toFixed(2) +

            "<hr>" +

            "<b>Total fare:</b> £" +
            total.toFixed(2) +

            "<br><br>" +

            "<div class='notice'>" +

            "<b>Waverley fare reference</b><br>" +

            "The Waverley tariff uses " +
            "128 yards or 22 seconds, whichever occurs first, " +
            "for its time/distance progression." +

            "<br><br>" +

            "Traffic/waiting entered above is treated as " +
            "additional delay time and should not include " +
            "the normal estimated driving time." +

            "</div>";


        result.style.display = "block";


    }

    catch (e) {

        error.innerHTML =
            '<div class="error">' +
            escapeHtml(
                e.message
            ) +
            '</div>';

    }


    loading.style.display = "none";
}


/* =====================================================
   SAFE TEXT
   ===================================================== */

function escapeHtml(text) {

    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}

</script>

</body>
</html>
